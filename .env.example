# Куда стучится vite dev-proxy /api (см. vite.config.js). Смени, если бэк
# (raketka, Spring Boot) поднят не на localhost:8080.
VITE_BACKEND_URL=http://localhost:8080

# Базовый путь для api/client.js. Оставь как есть при работе через dev-proxy;
# меняй только если фронт и бэк не идут через один и тот же origin (прод-сборка
# без прокси — тогда укажи полный адрес бэка, например http://localhost:8080/api,
# и добавь CORS на бэке).
VITE_API_BASE_URL=/api
